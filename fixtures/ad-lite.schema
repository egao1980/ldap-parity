# Optional AD-lite attributes (Microsoft OIDs). Loaded by osixia when present.
# Tests skip when sAMAccountName is not in the DIT.

attributetype ( 1.2.840.113556.1.4.221
  NAME 'sAMAccountName'
  DESC 'AD-lite sAMAccountName'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.4.656
  NAME 'userPrincipalName'
  DESC 'AD-lite userPrincipalName'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

objectclass ( 1.3.6.1.4.1.55555.1.1
  NAME 'adLiteAccount'
  DESC 'Optional AD-lite auxiliary class'
  SUP top
  AUXILIARY
  MAY ( sAMAccountName $ userPrincipalName ) )
